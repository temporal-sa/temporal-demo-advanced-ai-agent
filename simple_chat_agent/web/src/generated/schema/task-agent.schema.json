{
  "agent": "TaskAgent",
  "source": "simple_chat_agent.agent.subagents:TaskAgent",
  "init_data": {
    "data": {
      "$ref": "#/$defs/SubagentInit"
    },
    "required": true
  },
  "handlers": {
    "task": {
      "description": "Work on one task in the workspace until it is done, then report what was done.",
      "mid_turn": "reject",
      "input": {
        "$ref": "#/$defs/TaskRequest"
      },
      "output": {
        "$ref": "#/$defs/TaskResult"
      }
    }
  },
  "states": {},
  "$defs": {
    "ApprovalHistoryEntry": {
      "description": "One call a human decided after it was escalated (asked), kept so the auto-mode judge\ncan recognize a similar future call instead of asking again.\n\n``args_summary`` is a compact, bounded rendering of the call's arguments (see\n``approvals.summarize_tool_args``), never the raw dict: it rides along in CarriedState and\nin every judge prompt for the tool, so it has to stay small regardless of how large a call's\nreal arguments were. ``reason`` is the human's stated reason, if they gave one, also bounded.",
      "properties": {
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "args_summary": {
          "title": "Args Summary",
          "type": "string"
        },
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "args_summary",
        "approved"
      ],
      "title": "ApprovalHistoryEntry",
      "type": "object"
    },
    "Issue": {
      "description": "One problem the reviewer found.",
      "properties": {
        "severity": {
          "description": "blocker, major or minor",
          "title": "Severity",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "comment": {
          "title": "Comment",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "path",
        "line",
        "comment"
      ],
      "title": "Issue",
      "type": "object"
    },
    "ModelChoice": {
      "description": "A provider plus a model id from that provider's allowlist.",
      "properties": {
        "provider": {
          "default": "anthropic",
          "enum": [
            "anthropic",
            "openai",
            "google"
          ],
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "default": "claude-sonnet-5-5",
          "title": "Model",
          "type": "string"
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        }
      },
      "title": "ModelChoice",
      "type": "object"
    },
    "Review": {
      "description": "The reviewer's verdict on the diff.",
      "properties": {
        "verdict": {
          "description": "approve or request_changes",
          "title": "Verdict",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "summary",
        "issues"
      ],
      "title": "Review",
      "type": "object"
    },
    "SubagentInit": {
      "description": "What a subagent starts with: its type and model, and the parent's workspace, identity\nand session settings.",
      "properties": {
        "subagent_type": {
          "default": "general",
          "enum": [
            "general",
            "explore",
            "review"
          ],
          "title": "Subagent Type",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "owner_id": {
          "default": "",
          "title": "Owner Id",
          "type": "string"
        },
        "session_id": {
          "default": "",
          "title": "Session Id",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelChoice"
        },
        "environment": {
          "default": "catalog",
          "enum": [
            "catalog",
            "local"
          ],
          "title": "Environment",
          "type": "string"
        },
        "judge": {
          "default": "llm",
          "enum": [
            "llm",
            "jev"
          ],
          "title": "Judge",
          "type": "string"
        },
        "research_tools": {
          "items": {
            "type": "string"
          },
          "title": "Research Tools",
          "type": "array"
        },
        "test_tools": {
          "default": false,
          "title": "Test Tools",
          "type": "boolean"
        }
      },
      "required": [
        "workspace_id"
      ],
      "title": "SubagentInit",
      "type": "object"
    },
    "TaskCommit": {
      "description": "A local commit a subagent made.",
      "properties": {
        "hash": {
          "title": "Hash",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "hash",
        "message"
      ],
      "title": "TaskCommit",
      "type": "object"
    },
    "TaskFileChange": {
      "description": "A file a subagent changed while it worked.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "status": {
          "default": "modified",
          "title": "Status",
          "type": "string"
        },
        "added": {
          "default": 0,
          "title": "Added",
          "type": "integer"
        },
        "removed": {
          "default": 0,
          "title": "Removed",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "status",
        "added",
        "removed"
      ],
      "title": "TaskFileChange",
      "type": "object"
    },
    "TaskRequest": {
      "description": "What the parent sends a subagent: one task to work on until done.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "approval_history": {
          "items": {
            "$ref": "#/$defs/ApprovalHistoryEntry"
          },
          "title": "Approval History",
          "type": "array"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "TaskRequest",
      "type": "object"
    },
    "TaskResult": {
      "description": "A subagent's report on its task. ``text`` is its final message; the parent's Changes\npanel folds in ``changed_files`` and ``commits``.",
      "properties": {
        "subagent_id": {
          "default": "",
          "title": "Subagent Id",
          "type": "string"
        },
        "subagent_type": {
          "default": "general",
          "enum": [
            "general",
            "explore",
            "review"
          ],
          "title": "Subagent Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "changed_files": {
          "items": {
            "$ref": "#/$defs/TaskFileChange"
          },
          "title": "Changed Files",
          "type": "array"
        },
        "commits": {
          "items": {
            "$ref": "#/$defs/TaskCommit"
          },
          "title": "Commits",
          "type": "array"
        }
      },
      "required": [
        "subagent_id",
        "subagent_type",
        "text",
        "review",
        "changed_files",
        "commits"
      ],
      "title": "TaskResult",
      "type": "object"
    }
  }
}
